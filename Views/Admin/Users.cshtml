@model EMS_MVC.ViewModels.Admin.UserManagementViewModel
@{
    ViewData["Title"] = "Quản lý người dùng & Phân quyền";
    Layout = "_Layout";
}

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-extrabold text-on-surface tracking-tight">Quản lý người dùng &amp; Phân quyền</h1>
        <p class="text-xs text-status-neutral mt-1">Quản trị viên kiểm tra hồ sơ, kích hoạt tài khoản chờ duyệt và cấp quyền hệ thống</p>
    </div>

    <!-- 4 KPI Thống kê người dùng -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-surface rounded-2xl p-5 shadow-sm border border-border-subtle flex flex-col justify-between">
            <span class="text-[11px] font-bold uppercase tracking-wider text-status-neutral">Tổng tài khoản</span>
            <div class="text-2xl font-extrabold text-on-surface mt-2">@Model.TotalUsers</div>
        </div>

        <div class="bg-surface rounded-2xl p-5 shadow-sm border border-border-subtle flex flex-col justify-between">
            <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-700">Đang hoạt động (ACTIVE)</span>
            <div class="text-2xl font-extrabold text-status-success mt-2">@Model.ActiveUsers</div>
        </div>

        <div class="bg-amber-50/50 rounded-2xl p-5 shadow-sm border border-amber-200 flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold uppercase tracking-wider text-amber-800">Chờ kích hoạt</span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-200 text-amber-900">Ưu tiên</span>
            </div>
            <div class="text-2xl font-extrabold text-amber-800 mt-2">@Model.PendingUsers</div>
        </div>

        <div class="bg-surface rounded-2xl p-5 shadow-sm border border-border-subtle flex flex-col justify-between">
            <span class="text-[11px] font-bold uppercase tracking-wider text-rose-700">Khóa / Từ chối</span>
            <div class="text-2xl font-extrabold text-status-danger mt-2">@Model.DisabledUsers</div>
        </div>
    </div>

    <!-- Bộ lọc tìm kiếm & Tab trạng thái -->
    <div class="bg-surface rounded-2xl p-5 shadow-sm border border-border-subtle">
        <form method="get" asp-action="Users">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
                <div class="md:col-span-6 flex flex-col gap-1.5">
                    <label class="text-xs font-semibold text-on-surface">Tìm kiếm người dùng</label>
                    <div class="relative">
                        <input type="text" name="keyword" value="@Model.SearchKeyword" class="w-full h-10 pl-9 pr-3 rounded-xl bg-slate-50 text-sm border border-border-subtle focus:outline-none focus:border-primary transition-all" placeholder="Tìm theo Username, MSSV, Họ tên, Email..." />
                        <span class="material-symbols-outlined absolute left-2.5 top-2.5 text-[18px] text-status-neutral pointer-events-none">search</span>
                    </div>
                </div>

                <div class="md:col-span-4 flex flex-col gap-1.5">
                    <label class="text-xs font-semibold text-on-surface">Lọc theo trạng thái</label>
                    <select name="statusFilter" class="w-full h-10 px-3 rounded-xl bg-slate-50 text-sm border border-border-subtle focus:outline-none focus:border-primary cursor-pointer transition-all">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="PENDING_APPROVAL" selected="@(Model.StatusFilter == "PENDING_APPROVAL")">Chờ duyệt (PENDING_APPROVAL)</option>
                        <option value="ACTIVE" selected="@(Model.StatusFilter == "ACTIVE")">Đang hoạt động (ACTIVE)</option>
                        <option value="INACTIVE" selected="@(Model.StatusFilter == "INACTIVE")">Chưa kích hoạt (INACTIVE)</option>
                        <option value="LOCKED" selected="@(Model.StatusFilter == "LOCKED")">Bị khóa (LOCKED)</option>
                    </select>
                </div>

                <div class="md:col-span-2 flex gap-2">
                    <button type="submit" class="flex-1 h-10 rounded-xl bg-primary text-white hover:bg-primary-container font-bold text-xs shadow-sm transition-all flex items-center justify-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">filter_list</span>
                        <span>Lọc</span>
                    </button>
                    <a asp-action="Users" class="h-10 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-status-neutral flex items-center justify-center transition-colors">
                        <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Bảng danh sách tài khoản -->
    <div class="bg-surface rounded-2xl shadow-sm border border-border-subtle overflow-hidden">
        @if (Model.Users.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 border-b border-border-subtle text-[11px] font-bold uppercase tracking-wider text-status-neutral">
                        <tr>
                            <th class="py-3.5 px-5">Tài khoản &amp; Họ tên</th>
                            <th class="py-3.5 px-4">MSSV / Lớp</th>
                            <th class="py-3.5 px-4">Email / SĐT</th>
                            <th class="py-3.5 px-4">Vai trò</th>
                            <th class="py-3.5 px-4">Trạng thái</th>
                            <th class="py-3.5 px-5 text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-subtle text-slate-700">
                        @foreach (var user in Model.Users)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="py-4 px-5">
                                    <div class="font-bold text-on-surface text-sm">@user.FullName</div>
                                    <div class="text-[11px] text-slate-400 font-mono">@user.Username</div>
                                </td>
                                <td class="py-4 px-4">
                                    @if (!string.IsNullOrEmpty(user.StudentCode))
                                    {
                                        <div class="font-bold text-slate-800 font-mono">@user.StudentCode</div>
                                        <div class="text-[11px] text-slate-400">@user.ClassName</div>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">—</span>
                                    }
                                </td>
                                <td class="py-4 px-4">
                                    <div class="text-slate-700">@(user.Email ?? "—")</div>
                                    <div class="text-[11px] text-slate-400">@(user.PhoneNumber ?? "—")</div>
                                </td>
                                <td class="py-4 px-4">
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-primary border border-blue-200 mr-1">
                                            @role
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-4 whitespace-nowrap">
                                    @if (user.Status == "ACTIVE")
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">Hoạt động</span>
                                    }
                                    else if (user.Status == "PENDING_APPROVAL")
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 animate-pulse">Chờ kích hoạt</span>
                                    }
                                    else if (user.Status == "LOCKED")
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-800">Đã khóa</span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700">@user.Status</span>
                                    }
                                </td>
                                <td class="py-4 px-5 text-right whitespace-nowrap">
                                    @if (user.Status == "PENDING_APPROVAL")
                                    {
                                        <form asp-action="ApproveUser" asp-route-id="@user.UserId" method="post" class="m-0 inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-sm transition-colors" onclick="return confirm('Xác nhận duyệt và kích hoạt tài khoản sinh viên này?')">
                                                Kích hoạt
                                            </button>
                                        </form>
                                    }
                                    else if (user.Status == "ACTIVE")
                                    {
                                        <form asp-action="ToggleUserStatus" asp-route-id="@user.UserId" method="post" class="m-0 inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="px-3 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-bold transition-colors" onclick="return confirm('Bạn có chắc muốn tạm khóa tài khoản này?')">
                                                Khóa
                                            </button>
                                        </form>
                                    }
                                    else if (user.Status == "LOCKED" || user.Status == "INACTIVE")
                                    {
                                        <form asp-action="ToggleUserStatus" asp-route-id="@user.UserId" method="post" class="m-0 inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="px-3 py-1.5 rounded-lg bg-blue-50 hover:bg-blue-100 text-primary text-xs font-bold transition-colors">
                                                Mở khóa
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-12 text-slate-500 text-xs">
                Không tìm thấy tài khoản nào phù hợp với bộ lọc hiện tại.
            </div>
        }
    </div>
</div>
