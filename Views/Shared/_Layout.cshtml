@using System.Security.Claims
@using EMS_MVC.Models.Enums
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EMS-MVC | Hệ thống Quản lý và Tích điểm Hoạt động Sinh viên</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Material Symbols Outlined -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

    <!-- 1. Local Bootstrap 5 Core Framework (Standard Architecture) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- 2. Master Stitch Design Tokens & Custom Stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- 3. Tailwind CSS CDN (Preflight disabled so it harmonizes perfectly with Bootstrap) -->
    <script>
        tailwind = {
            config: {
                "darkMode": "class",
                "corePlugins": {
                    "preflight": false
                },
                "theme": {
                    "extend": {
                        "colors": {
                            "primary": "#00288e",
                            "primary-container": "#1e40af",
                            "primary-light": "#EFF6FF",
                            "primary-fixed": "#dde1ff",
                            "on-primary": "#ffffff",
                            "on-primary-container": "#a8b8ff",
                            "secondary": "#515f74",
                            "secondary-container": "#d5e3fc",
                            "on-secondary": "#ffffff",
                            "background": "#F8FAFC",
                            "surface": "#FFFFFF",
                            "on-surface": "#0b1c30",
                            "on-surface-variant": "#444653",
                            "surface-bright": "#f8f9ff",
                            "surface-container": "#e5eeff",
                            "surface-container-low": "#eff4ff",
                            "surface-container-lowest": "#ffffff",
                            "surface-container-high": "#dce9ff",
                            "status-success": "#059669",
                            "status-success-bg": "#ECFDF5",
                            "status-warning": "#D97706",
                            "status-warning-bg": "#FFFBEB",
                            "status-danger": "#DC2626",
                            "status-danger-bg": "#FEF2F2",
                            "status-info": "#0284C7",
                            "status-info-bg": "#F0F9FF",
                            "status-neutral": "#64748B",
                            "status-neutral-bg": "#F1F5F9",
                            "border-subtle": "#E2E8F0"
                        },
                        "borderRadius": {
                            "DEFAULT": "0.25rem",
                            "lg": "0.5rem",
                            "xl": "0.75rem",
                            "2xl": "1rem",
                            "full": "9999px"
                        },
                        "fontFamily": {
                            "sans": ["Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"]
                        }
                    }
                }
            }
        };
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-background text-on-surface font-sans antialiased min-h-screen">

@{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString();

    // Phân định rõ 3 ngữ cảnh giao diện
    bool isPortalPage = User.Identity?.IsAuthenticated == true && 
        (currentCtrl == "Student" || 
         currentCtrl == "OrganizerActivities" || 
         currentCtrl == "ActivityApprovals" || 
         currentCtrl == "Admin" || 
         currentCtrl == "Attendance" ||
         (currentCtrl == "Account" && currentAct == "ChangePassword"));

    bool isAuthPage = currentCtrl == "Account" && 
        (currentAct == "Login" || currentAct == "Register" || currentAct == "PendingApproval" || currentAct == "AccessDenied");
}

@if (isPortalPage)
{
    <!-- ================= 1. AUTHENTICATED PORTAL LAYOUT (DEDICATED SIDEBAR & HEADER) ================= -->
    <aside class="portal-sidebar">
        <!-- Logo Brand -->
        <div class="portal-brand">
            <div class="w-9 h-9 rounded-xl bg-primary-light flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-primary text-[22px]">school</span>
            </div>
            <div class="flex flex-col">
                <a asp-controller="Home" asp-action="Index" class="font-bold text-primary tracking-tight text-base leading-tight no-underline">EMS-MVC</a>
                <span class="text-xs text-status-neutral font-medium">
                    @if (User.IsInRole(SystemRoles.Student)) { <span>Cổng Sinh viên</span> }
                    else if (User.IsInRole(SystemRoles.Organizer)) { <span>Ban Tổ Chức</span> }
                    else if (User.IsInRole(SystemRoles.Manager)) { <span>Cán bộ Quản lý</span> }
                    else if (User.IsInRole(SystemRoles.Admin)) { <span>Quản trị Hệ thống</span> }
                </span>
            </div>
        </div>

        <!-- Navigation Links -->
        <div class="portal-nav">
            <div class="portal-nav-title">Menu Chức Năng</div>

            @if (User.IsInRole(SystemRoles.Student))
            {
                var isDash = currentCtrl == "Student" && currentAct == "Dashboard";
                var isAct = currentCtrl == "Activities";
                var isMy = currentCtrl == "Student" && currentAct == "MyActivities";
                var isPart = currentCtrl == "Student" && currentAct == "ParticipationHistory";
                var isPoint = currentCtrl == "Student" && currentAct == "PointHistory";
                var isProf = currentCtrl == "Student" && currentAct == "Profile";

                <a asp-controller="Student" asp-action="Dashboard" class="portal-nav-link @(isDash ? "active" : "")">
                    <span class="material-symbols-outlined text-[20px]">dashboard</span>
                    <span>Tổng quan sinh viên</span>
                </a>
                <a asp-controller="Activities" asp-action="Index" class="portal-nav-link @(isAct ? "active" : "")">
                    <span class="material-symbols-outlined text-[20px]">event_available</span>
                    <span>Tra cứu hoạt động</span>
                </a>
                <a asp-controller="Student" asp-action="MyActivities" class="portal-nav-link @(isMy ? "active" : "")">
                    <span class="material-symbols-outlined text-[20px]">assignment_turned_in</span>
                    <span>Hoạt động đã đăng ký (UC-009)</span>
                </a>
                <a asp-controller="Student" asp-action="ParticipationHistory" class="portal-nav-link @(isPart ? "active" : "")">
                    <span class="material-symbols-outlined text-[20px]">history</span>
                    <span>Lịch sử tham gia (UC-011)</span>
                </a>
                <a asp-controller="Student" asp-action="PointHistory" class="portal-nav-link @(isPoint ? "active" : "")">
                    <span class="material-symbols-outlined text-[20px]">military_tech</span>
                    <span>Lịch sử tích lũy điểm (UC-012)</span>
                </a>
                <a asp-controller="Student" asp-action="Profile" class="portal-nav-link @(isProf ? "active" : "")">
                    <span class="material-symbols-outlined text-[20px]">account_circle</span>
                    <span>Hồ sơ cá nhân (UC-004)</span>
                </a>
                <div class="pt-2">
                    <span class="portal-nav-link text-slate-400 cursor-not-allowed opacity-60">
                        <span class="material-symbols-outlined text-[18px]">leaderboard</span>
                        <span>Bảng xếp hạng (GĐ 2)</span>
                    </span>
                    <span class="portal-nav-link text-slate-400 cursor-not-allowed opacity-60">
                        <span class="material-symbols-outlined text-[18px]">military_tech</span>
                        <span>Huy hiệu (GĐ 2)</span>
                    </span>
                </div>
            }

            @if (User.IsInRole(SystemRoles.Organizer))
            {
                var isOrgList = currentCtrl == "OrganizerActivities" && currentAct == "Index";
                var isOrgCreate = currentCtrl == "OrganizerActivities" && currentAct == "Create";
                var isAct = currentCtrl == "Activities";

                <a asp-controller="OrganizerActivities" asp-action="Index" class="portal-nav-link @(isOrgList ? "active" : "")">
                    <span class="material-symbols-outlined text-[20px]">event_note</span>
                    <span>Quản lý hoạt động BTC</span>
                </a>
                <a asp-controller="OrganizerActivities" asp-action="Create" class="portal-nav-link @(isOrgCreate ? "active" : "")">
                    <span class="material-symbols-outlined text-[20px]">add_circle</span>
                    <span>Tạo hoạt động mới (UC-016)</span>
                </a>
                <a asp-controller="Activities" asp-action="Index" class="portal-nav-link @(isAct ? "active" : "")">
                    <span class="material-symbols-outlined text-[20px]">explore</span>
                    <span>Tra cứu chung</span>
                </a>
            }

            @if (User.IsInRole(SystemRoles.Manager))
            {
                var isReports = currentCtrl == "ActivityApprovals" && currentAct == "Reports";
                var isQueue = currentCtrl == "ActivityApprovals" && currentAct == "Index";
                var isAct = currentCtrl == "Activities";

                <a asp-controller="ActivityApprovals" asp-action="Reports" class="portal-nav-link @(isReports ? "active" : "")">
                    <span class="material-symbols-outlined text-[20px]">analytics</span>
                    <span>Báo cáo quản lý (UC-028)</span>
                </a>
                <a asp-controller="ActivityApprovals" asp-action="Index" class="portal-nav-link @(isQueue ? "active" : "")">
                    <span class="material-symbols-outlined text-[20px]">rule</span>
                    <span>Hàng đợi phê duyệt (UC-024, UC-025)</span>
                </a>
                <a asp-controller="Activities" asp-action="Index" class="portal-nav-link @(isAct ? "active" : "")">
                    <span class="material-symbols-outlined text-[20px]">visibility</span>
                    <span>Tất cả hoạt động</span>
                </a>
            }

            @if (User.IsInRole(SystemRoles.Admin))
            {
                var isAdminUsers = currentCtrl == "Admin" && currentAct == "Users";
                var isReports = currentCtrl == "ActivityApprovals" && currentAct == "Reports";

                <a asp-controller="Admin" asp-action="Users" class="portal-nav-link @(isAdminUsers ? "active" : "")">
                    <span class="material-symbols-outlined text-[20px]">manage_accounts</span>
                    <span>Quản lý người dùng (UC-029)</span>
                </a>
                <a asp-controller="Admin" asp-action="Users" asp-route-statusFilter="PENDING_APPROVAL" class="portal-nav-link">
                    <span class="material-symbols-outlined text-[20px]">verified_user</span>
                    <span>Tài khoản chờ duyệt</span>
                </a>
                <a asp-controller="ActivityApprovals" asp-action="Reports" class="portal-nav-link @(isReports ? "active" : "")">
                    <span class="material-symbols-outlined text-[20px]">analytics</span>
                    <span>Báo cáo hệ thống</span>
                </a>
                <a asp-controller="Activities" asp-action="Index" class="portal-nav-link">
                    <span class="material-symbols-outlined text-[20px]">visibility</span>
                    <span>Tất cả hoạt động</span>
                </a>
            }
        </div>

        <!-- Sidebar Footer -->
        <div class="p-3 border-t border-border-subtle bg-slate-50 mt-auto">
            <div class="flex items-center justify-between text-xs">
                <div>
                    <span class="font-semibold text-slate-700 block">EMS-MVC Core</span>
                    <span class="text-slate-400">.NET 10 • EF Core 10</span>
                </div>
                <span class="px-2 py-0.5 rounded-full bg-primary/10 text-primary font-bold text-[10px]">Mốc ~60%</span>
            </div>
        </div>
    </aside>

    <!-- Top Header -->
    <header class="portal-header">
        <div class="flex items-center gap-3 text-sm">
            <a asp-controller="Home" asp-action="Index" class="text-status-neutral hover:text-primary transition-colors no-underline">Trang chủ</a>
            <span class="text-slate-300">/</span>
            <span class="text-on-surface font-semibold">@ViewData["Title"]</span>
        </div>

        <div class="flex items-center gap-4">
            <!-- Search Quick Bar -->
            <form asp-controller="Activities" asp-action="Index" method="get" class="relative hidden md:block m-0">
                <span class="material-symbols-outlined absolute left-3 top-2.5 text-[18px] text-status-neutral pointer-events-none">search</span>
                <input name="search" class="form-control form-control-sm ps-5 pe-3 rounded-pill bg-light text-sm" style="width: 240px; height: 36px;" placeholder="Tìm hoạt động..." type="text"/>
            </form>

            <!-- User Profile Dropdown -->
            <div class="dropdown">
                <button class="btn btn-sm btn-light border-0 dropdown-toggle d-flex align-items-center gap-2 p-1 pe-2 rounded-pill" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center font-bold text-xs shadow-sm">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <span class="text-sm font-semibold text-dark d-none d-lg-inline">@User.Identity?.Name</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 py-2 mt-2">
                    <li class="px-3 py-2 border-bottom">
                        <div class="font-bold text-dark text-sm">@User.Identity?.Name</div>
                        <div class="text-muted text-xs">@string.Join(", ", User.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value))</div>
                    </li>
                    @if (User.IsInRole(SystemRoles.Student))
                    {
                        <li>
                            <a asp-controller="Student" asp-action="Profile" class="dropdown-item d-flex align-items-center gap-2 py-2 text-sm">
                                <span class="material-symbols-outlined text-[18px]">person</span> Hồ sơ cá nhân
                            </a>
                        </li>
                    }
                    <li>
                        <a asp-controller="Account" asp-action="ChangePassword" class="dropdown-item d-flex align-items-center gap-2 py-2 text-sm">
                            <span class="material-symbols-outlined text-[18px]">lock_reset</span> Đổi mật khẩu
                        </a>
                    </li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2 py-2 text-sm">
                                <span class="material-symbols-outlined text-[18px]">logout</span> Đăng xuất
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <!-- Main Content for Portal -->
    <main class="portal-main">
        <div class="portal-content-container">
            <!-- Flash Alert Notifications -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="flash-alert flash-alert-success">
                    <span class="material-symbols-outlined text-[22px]">check_circle</span>
                    <div>@TempData["SuccessMessage"]</div>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="flash-alert flash-alert-danger">
                    <span class="material-symbols-outlined text-[22px]">error</span>
                    <div>@TempData["ErrorMessage"]</div>
                </div>
            }

            @RenderBody()
        </div>
    </main>
}
else if (isAuthPage)
{
    <!-- ================= 2. AUTHENTICATION SCREENS (LOGIN, REGISTER, PENDING) ================= -->
    <main class="min-h-screen flex items-center justify-center p-4 bg-background">
        @RenderBody()
    </main>
}
else
{
    <!-- ================= 3. PUBLIC PAGES (HOME LANDING PAGE & ACTIVITY CATALOGUE) ================= -->
    <header class="public-header">
        <div class="public-header-inner">
            <div class="flex items-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 no-underline">
                    <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center text-white shadow-sm">
                        <span class="material-symbols-outlined text-[24px]">school</span>
                    </div>
                    <div class="flex flex-col text-left">
                        <span class="font-bold text-primary tracking-tight text-lg leading-tight">EMS-MVC</span>
                        <span class="text-xs text-status-neutral font-medium">Cổng Quản lý & Tích điểm Hoạt động Sinh viên</span>
                    </div>
                </a>
            </div>

            <div class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-700">
                <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors no-underline @(currentCtrl == "Home" ? "text-primary font-bold" : "")">Trang chủ</a>
                <a asp-controller="Activities" asp-action="Index" class="hover:text-primary transition-colors no-underline @(currentCtrl == "Activities" ? "text-primary font-bold" : "")">Tra cứu hoạt động</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="quy-che" class="hover:text-primary transition-colors no-underline">Quy chế rèn luyện</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="huong-dan" class="hover:text-primary transition-colors no-underline">Hướng dẫn tích điểm</a>
            </div>

            <div class="flex items-center gap-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="flex items-center gap-3">
                        <span class="text-sm font-semibold text-slate-700 hidden sm:inline">
                            Xin chào, <strong class="text-primary">@User.Identity.Name</strong>
                        </span>

                        @if (User.IsInRole(SystemRoles.Student))
                        {
                            <a asp-controller="Student" asp-action="Dashboard" class="btn-primary-custom text-xs">
                                <span class="material-symbols-outlined text-[18px]">dashboard</span>
                                <span>Cổng Sinh viên</span>
                            </a>
                        }
                        else if (User.IsInRole(SystemRoles.Organizer))
                        {
                            <a asp-controller="OrganizerActivities" asp-action="Index" class="btn-primary-custom text-xs">
                                <span class="material-symbols-outlined text-[18px]">event_note</span>
                                <span>Ban Tổ Chức</span>
                            </a>
                        }
                        else if (User.IsInRole(SystemRoles.Manager))
                        {
                            <a asp-controller="ActivityApprovals" asp-action="Index" class="btn-primary-custom text-xs">
                                <span class="material-symbols-outlined text-[18px]">rule</span>
                                <span>Phê duyệt</span>
                            </a>
                        }
                        else if (User.IsInRole(SystemRoles.Admin))
                        {
                            <a asp-controller="Admin" asp-action="Users" class="btn-primary-custom text-xs">
                                <span class="material-symbols-outlined text-[18px]">manage_accounts</span>
                                <span>Quản trị</span>
                            </a>
                        }

                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1 rounded-pill" title="Đăng xuất">
                                <span class="material-symbols-outlined text-[16px]">logout</span>
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn-primary-custom text-xs">
                        <span class="material-symbols-outlined text-[18px]">login</span>
                        <span>Đăng nhập</span>
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-primary text-xs font-semibold transition-all no-underline">
                        <span class="material-symbols-outlined text-[18px]">person_add</span>
                        <span class="hidden sm:inline">Đăng ký</span>
                    </a>
                }
            </div>
        </div>
    </header>

    <main class="public-main">
        <!-- Flash Alert Notifications -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="max-w-7xl mx-auto px-4 pt-4">
                <div class="flash-alert flash-alert-success">
                    <span class="material-symbols-outlined text-[22px]">check_circle</span>
                    <div>@TempData["SuccessMessage"]</div>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="max-w-7xl mx-auto px-4 pt-4">
                <div class="flash-alert flash-alert-danger">
                    <span class="material-symbols-outlined text-[22px]">error</span>
                    <div>@TempData["ErrorMessage"]</div>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Institutional Footer -->
    <footer class="public-footer">
        <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
            <div class="flex items-center gap-2 text-primary font-bold">
                <span class="material-symbols-outlined text-[20px]">verified</span>
                <span>Hệ thống EMS-MVC • Mốc hoàn thành ~60%</span>
            </div>
            <div>Đồ án: Hệ thống Quản lý và Tích điểm Hoạt động Sinh viên (ASP.NET Core MVC .NET 10)</div>
            <div class="text-xs text-slate-400">Nhóm thực hiện: Lê Thành Đạt • Lê Thành Hy • Ngô Trọng Thiện</div>
        </div>
    </footer>
}

<!-- Bootstrap 5 Bundle & jQuery (Local Offline Reliable) -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
