@model EMS_MVC.ViewModels.Attendance.ActivitySessionsViewModel
@{
    ViewData["Title"] = "Phiên điểm danh - " + Model.ActivityName;
    Layout = "_Layout";
}

<div class="mb-3">
    <a asp-controller="OrganizerActivities" asp-action="Details" asp-route-id="@Model.ActivityId" class="text-secondary text-decoration-none small d-inline-flex align-items-center gap-1">
        <span class="material-symbols-outlined fs-6">arrow_back</span> Quay lại quản trị hoạt động
    </a>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">QUẢN LÝ PHIÊN ĐIỂM DANH</h4>
        <p class="text-secondary small mb-0">Hoạt động: <strong>@Model.ActivityName</strong> (Chế độ: @(Model.AttendanceMode == "CHECKIN_ONLY" ? "Check-in đơn" : "Check-in & Check-out"))</p>
    </div>
</div>

<div class="row g-4">
    <!-- Cột trái: Danh sách các phiên điểm danh -->
    <div class="col-lg-8">
        <div class="card card-custom p-0 overflow-hidden shadow-sm">
            <div class="p-3 bg-light border-bottom">
                <h6 class="fw-bold mb-0 text-dark">Các phiên điểm danh đã tạo</h6>
            </div>

            @if (Model.Sessions.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Tên phiên</th>
                                <th>Thời gian phiên</th>
                                <th>Số lượng có mặt</th>
                                <th>Trạng thái</th>
                                <th class="text-end pe-4">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Sessions)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="fw-bold text-dark d-block">@(s.SessionName ?? "Phiên điểm danh")</span>
                                        <small class="text-muted">Tạo lúc: @s.CreatedAt.ToString("dd/MM HH:mm")</small>
                                    </td>
                                    <td class="small">
                                        <div>@s.StartsAt.ToString("dd/MM/yyyy HH:mm")</div>
                                        <small class="text-muted">đến @s.EndsAt.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <span class="badge badge-open fs-6">@s.AttendeeCount người</span>
                                    </td>
                                    <td>
                                        @if (s.Status == "OPEN")
                                        {
                                            <span class="badge badge-open">ĐANG MỞ (OPEN)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">ĐÃ ĐÓNG (CLOSED)</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-1">
                                            <!-- Nút điểm danh thủ công -->
                                            <a asp-action="Manual" asp-route-sessionId="@s.SessionId" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" title="Điểm danh thủ công">
                                                <span class="material-symbols-outlined fs-6">how_to_reg</span>
                                                <span>Điểm danh</span>
                                            </a>

                                            <!-- Nút đóng phiên nếu đang mở -->
                                            @if (s.Status == "OPEN")
                                            {
                                                <form asp-action="CloseSession" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn đóng phiên điểm danh này không?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="sessionId" value="@s.SessionId" />
                                                    <input type="hidden" name="activityId" value="@Model.ActivityId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1" title="Đóng phiên">
                                                        <span class="material-symbols-outlined fs-6">lock</span>
                                                        <span>Đóng</span>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <span class="material-symbols-outlined fs-1 text-secondary mb-2">qr_code_2</span>
                    <h6>Chưa có phiên điểm danh nào</h6>
                    <p class="small mb-0">Hãy tạo phiên điểm danh bên cạnh để tiến hành ghi nhận tham gia.</p>
                </div>
            }
        </div>
    </div>

    <!-- Cột phải: Form tạo phiên điểm danh mới -->
    <div class="col-lg-4">
        <div class="card card-custom p-4 shadow-sm">
            <h5 class="fw-bold text-dark mb-3">Tạo phiên điểm danh mới</h5>

            <form asp-action="CreateSession" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ActivityId" value="@Model.ActivityId" />

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Tên phiên điểm danh</label>
                    <input type="text" name="SessionName" class="form-control" value="Điểm danh chính thức" required />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Bắt đầu</label>
                    <input type="datetime-local" name="StartsAt" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-semibold text-secondary">Kết thúc</label>
                    <input type="datetime-local" name="EndsAt" class="form-control" value="@DateTime.Now.AddHours(2).ToString("yyyy-MM-ddTHH:mm")" required />
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 justify-content-center py-2">
                    <span class="material-symbols-outlined">add_task</span>
                    <span>TẠO PHIÊN ĐIỂM DANH</span>
                </button>
            </form>

            <div class="mt-4 p-3 bg-light rounded-3 small text-muted">
                <div class="fw-semibold text-dark mb-1 d-flex align-items-center gap-1">
                    <span class="material-symbols-outlined fs-6 text-primary">info</span> Ghi chú giai đoạn 60%:
                </div>
                <span>Điểm danh thủ công (Manual Attendance) được triển khai hoàn chỉnh. Chức năng QR động có thời hạn và tự động quét sẽ được bổ sung ở giai đoạn tiếp theo.</span>
            </div>
        </div>
    </div>
</div>
