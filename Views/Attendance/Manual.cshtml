@model EMS_MVC.ViewModels.Attendance.ManualAttendanceViewModel
@{
    ViewData["Title"] = "Điểm danh thủ công - " + Model.SessionName;
    Layout = "_Layout";
}

<div class="mb-3">
    <a asp-action="Sessions" asp-route-activityId="@Model.ActivityId" class="text-secondary text-decoration-none small d-inline-flex align-items-center gap-1">
        <span class="material-symbols-outlined fs-6">arrow_back</span> Quay lại danh sách phiên điểm danh
    </a>
</div>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h4 class="fw-bold text-dark mb-0">ĐIỂM DANH THỦ CÔNG</h4>
            @if (Model.SessionStatus == "OPEN")
            {
                <span class="badge badge-open">PHIÊN ĐANG MỞ (OPEN)</span>
            }
            else
            {
                <span class="badge bg-secondary">PHIÊN ĐÃ ĐÓNG (CLOSED)</span>
            }
        </div>
        <p class="text-secondary small mb-0">
            Hoạt động: <strong>@Model.ActivityName</strong> • Phiên: <strong>@Model.SessionName</strong>
        </p>
    </div>
</div>

<!-- Thanh tìm kiếm sinh viên -->
<div class="card card-custom p-3 mb-4 shadow-sm">
    <form method="get" asp-action="Manual">
        <input type="hidden" name="sessionId" value="@Model.SessionId" />
        <div class="row g-2">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <span class="material-symbols-outlined fs-6">search</span>
                    </span>
                    <input type="text" name="keyword" value="@Model.SearchKeyword" class="form-control border-start-0 ps-1" placeholder="Tìm kiếm nhanh theo MSSV, Họ tên hoặc Lớp sinh hoạt..." />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary-custom flex-grow-1 justify-content-center py-2">
                    Tìm kiếm
                </button>
                <a asp-action="Manual" asp-route-sessionId="@Model.SessionId" class="btn btn-outline-secondary d-flex align-items-center justify-content-center px-2" title="Làm mới">
                    <span class="material-symbols-outlined fs-6">refresh</span>
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Bảng danh sách sinh viên đã đăng ký hợp lệ (BR04) -->
<div class="card card-custom p-0 overflow-hidden shadow-sm">
    @if (Model.Registrations.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">MSSV</th>
                        <th>Họ và tên</th>
                        <th>Lớp</th>
                        <th>Khoa</th>
                        <th>Trạng thái điểm danh</th>
                        <th>Thời gian ghi nhận</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Registrations)
                    {
                        <tr>
                            <td class="ps-4"><strong class="text-dark">@item.StudentCode</strong></td>
                            <td><span class="fw-semibold">@item.FullName</span></td>
                            <td><span class="badge bg-light text-dark border">@item.ClassName</span></td>
                            <td class="small text-secondary">@item.DepartmentName</td>
                            <td>
                                @if (item.IsCheckedIn)
                                {
                                    <span class="badge badge-open d-inline-flex align-items-center gap-1">
                                        <span class="material-symbols-outlined fs-6">check_circle</span> Đã có mặt
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-draft">Chưa điểm danh</span>
                                }
                            </td>
                            <td class="small text-muted">
                                @(item.CheckInAt?.ToString("dd/MM/yyyy HH:mm:ss") ?? "—")
                            </td>
                            <td class="text-end pe-4">
                                @if (item.IsCheckedIn)
                                {
                                    <button class="btn btn-sm btn-outline-success" disabled>
                                        <span class="material-symbols-outlined fs-6">done</span> Đã ghi nhận
                                    </button>
                                }
                                else if (Model.SessionStatus == "OPEN")
                                {
                                    <form asp-action="CheckInManual" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="sessionId" value="@Model.SessionId" />
                                        <input type="hidden" name="registrationId" value="@item.RegistrationId" />
                                        <button type="submit" class="btn btn-sm btn-primary-custom py-1 px-3" style="font-size: 0.78rem;">
                                            <span class="material-symbols-outlined fs-6">how_to_reg</span>
                                            <span>Điểm danh</span>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Phiên đã đóng</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <span class="material-symbols-outlined fs-1 text-secondary mb-2">person_off</span>
            <h5>Không tìm thấy sinh viên nào trong danh sách đăng ký</h5>
            <p class="small mb-0">Chỉ những sinh viên đã đăng ký hợp lệ mới có tên trong danh sách điểm danh (BR04).</p>
        </div>
    }
</div>
