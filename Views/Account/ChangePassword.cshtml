@model EMS_MVC.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card card-custom p-4">
            <h5 class="fw-bold mb-1">ĐỔI MẬT KHẨU TÀI KHOẢN</h5>
            <p class="text-secondary small mb-4">Cập nhật mật khẩu định kỳ để nâng cao bảo mật tài khoản</p>

            <form asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Nhập mật khẩu hiện tại..." />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="Mật khẩu mới từ 6 ký tự..." />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmNewPassword" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="Xác nhận mật khẩu mới..." />
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 justify-content-center py-2">
                    <span class="material-symbols-outlined">save</span>
                    <span>CẬP NHẬT MẬT KHẨU</span>
                </button>
            </form>
        </div>
    </div>
</div>
