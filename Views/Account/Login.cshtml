@model EMS_MVC.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập hệ thống";
    Layout = "_Layout";
}

<div class="w-full max-w-md mx-auto flex flex-col items-center justify-center py-6 px-4">
    <!-- Top System Identification Header (Stitch Màn hình 01) -->
    <div class="flex items-center gap-3 mb-6">
        <div class="w-12 h-12 rounded-xl bg-surface shadow-sm border border-border-subtle p-2 flex items-center justify-center">
            <span class="material-symbols-outlined text-primary text-[28px]">school</span>
        </div>
        <div class="flex flex-col text-left">
            <span class="text-base text-primary font-extrabold tracking-tight">HỆ THỐNG EMS-MVC</span>
            <span class="text-xs text-status-neutral">Cổng Quản lý &amp; Tích điểm Hoạt động Ngoại khóa</span>
        </div>
    </div>

    <!-- Main Authentication Box Container -->
    <div class="w-full bg-surface rounded-2xl shadow-xl border border-border-subtle p-8 flex flex-col relative z-10">
        <!-- Box Title -->
        <div class="flex flex-col items-center text-center mb-6">
            <div class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-primary-light text-primary mb-3">
                <span class="material-symbols-outlined text-[24px]">school</span>
            </div>
            <h1 class="text-xl font-extrabold text-on-surface tracking-tight">ĐĂNG NHẬP HỆ THỐNG</h1>
            <p class="text-xs text-status-neutral mt-1">Cổng Quản lý và Tích điểm Hoạt động Sinh viên EMS-MVC</p>
        </div>

        <!-- Main Login Form (ASP.NET MVC Pattern) -->
        <form asp-action="Login" method="post" class="flex flex-col gap-4" id="loginForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="p-3 rounded-lg bg-status-danger-bg text-status-danger text-xs font-medium"></div>

            <!-- Field 1: Username / Student ID -->
            <div class="flex flex-col gap-1.5 text-left">
                <label asp-for="Username" class="text-xs font-semibold text-on-surface flex items-center justify-between">
                    <span>Tên đăng nhập / Mã sinh viên</span>
                    <span class="text-[11px] text-status-neutral font-normal">Bắt buộc</span>
                </label>
                <div class="relative flex items-center">
                    <span class="material-symbols-outlined absolute left-3.5 text-status-neutral text-[20px] pointer-events-none">badge</span>
                    <input asp-for="Username" id="usernameInput" class="w-full h-11 pl-11 pr-4 bg-surface text-on-surface rounded-lg text-sm border border-border-subtle shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="Ví dụ: sv210145 hoặc admin" autofocus required />
                </div>
                <span asp-validation-for="Username" class="text-status-danger text-xs"></span>
            </div>

            <!-- Field 2: Password -->
            <div class="flex flex-col gap-1.5 text-left">
                <label asp-for="Password" class="text-xs font-semibold text-on-surface flex items-center justify-between">
                    <span>Mật khẩu truy cập</span>
                    <span class="text-[11px] text-primary cursor-pointer hover:underline" onclick="alert('Vui lòng liên hệ Văn phòng Công tác Sinh viên (Phòng A1-102) hoặc gửi email tới ctsv@edu.vn để cấp lại mật khẩu.')">Quên mật khẩu?</span>
                </label>
                <div class="relative flex items-center">
                    <span class="material-symbols-outlined absolute left-3.5 text-status-neutral text-[20px] pointer-events-none">lock</span>
                    <input asp-for="Password" id="passwordInput" type="password" class="w-full h-11 pl-11 pr-11 bg-surface text-on-surface rounded-lg text-sm border border-border-subtle shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="Nhập mật khẩu..." required />
                    <button type="button" class="absolute right-3.5 p-1 text-status-neutral hover:text-on-surface focus:outline-none" onclick="togglePasswordVisibility()" title="Hiện / Ẩn mật khẩu">
                        <span class="material-symbols-outlined text-[20px] block" id="passwordIcon">visibility_off</span>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-status-danger text-xs"></span>
            </div>

            <!-- Remember Me Checkbox -->
            <div class="flex items-center justify-between pt-1">
                <label class="flex items-center gap-2 cursor-pointer select-none">
                    <input asp-for="RememberMe" class="w-4 h-4 rounded text-primary focus:ring-primary cursor-pointer border-border-subtle" />
                    <span class="text-xs text-slate-600">Ghi nhớ đăng nhập</span>
                </label>
                <span class="text-[11px] font-semibold text-status-neutral bg-slate-100 px-2 py-0.5 rounded">Học kỳ 2 / 2024–2025</span>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="w-full h-11 mt-2 bg-primary hover:bg-primary-container text-white text-sm font-bold rounded-xl shadow-md transition-all flex items-center justify-center gap-2 active:scale-95" id="btnSubmit">
                <span class="material-symbols-outlined text-[20px]">login</span>
                <span>ĐĂNG NHẬP</span>
            </button>
        </form>

        <!-- Security Notice -->
        <div class="mt-5 p-3 rounded-xl bg-status-warning-bg flex items-start gap-2.5 text-left border border-status-warning/20">
            <span class="material-symbols-outlined text-status-warning text-[20px] shrink-0 mt-0.5">verified_user</span>
            <p class="text-xs text-slate-700 leading-snug">
                <strong class="text-status-warning font-semibold">Lưu ý:</strong> Sinh viên dùng tài khoản được cấp. Tuyệt đối không chia sẻ mật khẩu để bảo vệ điểm rèn luyện cá nhân.
            </p>
        </div>

        <!-- Register Link -->
        <div class="mt-4 pt-3 text-center border-t border-border-subtle text-xs text-status-neutral">
            Chưa có tài khoản sinh viên?
            <a asp-action="Register" class="font-bold text-primary hover:underline ml-1">Đăng ký tại đây</a>
        </div>
    </div>

    <!-- Quick Demo Role Switcher Panel (Stitch Testing Sandbox) -->
    <div class="w-full max-w-md mt-6 bg-surface rounded-2xl shadow-sm border border-border-subtle p-4 flex flex-col gap-3">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-1.5 text-status-neutral">
                <span class="material-symbols-outlined text-[18px] text-primary">touch_app</span>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-700">Demo Nhanh Vai Trò (Testing Sandbox)</span>
            </div>
            <span class="text-[11px] px-2 py-0.5 rounded-full bg-status-info-bg text-status-info font-bold">1 Chạm Điền</span>
        </div>

        <div class="grid grid-cols-2 gap-2">
            <!-- Student -->
            <button type="button" class="flex items-center gap-2.5 p-2.5 rounded-xl bg-slate-50 hover:bg-blue-50 border border-slate-100 transition-colors text-left" onclick="fillCredentials('sv210145', 'Student@12345', 'Sinh viên (sv210145)')">
                <div class="w-7 h-7 rounded-lg bg-blue-100 text-primary flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[18px]">person</span>
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-xs font-bold text-on-surface truncate">Sinh viên</p>
                    <p class="text-[11px] text-status-neutral truncate font-mono">sv210145</p>
                </div>
            </button>

            <!-- BTC -->
            <button type="button" class="flex items-center gap-2.5 p-2.5 rounded-xl bg-slate-50 hover:bg-emerald-50 border border-slate-100 transition-colors text-left" onclick="fillCredentials('organizer', 'Organizer@12345', 'Ban tổ chức (organizer)')">
                <div class="w-7 h-7 rounded-lg bg-emerald-100 text-status-success flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[18px]">flag</span>
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-xs font-bold text-on-surface truncate">Ban tổ chức</p>
                    <p class="text-[11px] text-status-neutral truncate font-mono">organizer</p>
                </div>
            </button>

            <!-- Manager -->
            <button type="button" class="flex items-center gap-2.5 p-2.5 rounded-xl bg-slate-50 hover:bg-amber-50 border border-slate-100 transition-colors text-left" onclick="fillCredentials('manager', 'Manager@12345', 'Cán bộ quản lý (manager)')">
                <div class="w-7 h-7 rounded-lg bg-amber-100 text-status-warning flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[18px]">account_balance</span>
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-xs font-bold text-on-surface truncate">Cán bộ quản lý</p>
                    <p class="text-[11px] text-status-neutral truncate font-mono">manager</p>
                </div>
            </button>

            <!-- Admin -->
            <button type="button" class="flex items-center gap-2.5 p-2.5 rounded-xl bg-slate-50 hover:bg-rose-50 border border-slate-100 transition-colors text-left" onclick="fillCredentials('admin', 'Admin@12345', 'Quản trị viên (admin)')">
                <div class="w-7 h-7 rounded-lg bg-rose-100 text-status-danger flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[18px]">admin_panel_settings</span>
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-xs font-bold text-on-surface truncate">Quản trị viên</p>
                    <p class="text-[11px] text-status-neutral truncate font-mono">admin</p>
                </div>
            </button>
        </div>

        <div class="hidden text-center text-xs text-status-success bg-status-success-bg py-2 px-3 rounded-lg border border-status-success/20 font-medium" id="roleFilledBanner">
            Đã nạp thông tin: <span class="font-bold" id="filledRoleName"></span> (Bấm "Đăng nhập" để vào hệ thống)
        </div>
    </div>

    <!-- Institutional Footer Bar -->
    <div class="w-full max-w-md mt-6 flex flex-col items-center gap-1 text-center text-xs text-status-neutral">
        <div class="flex items-center gap-3">
            <a href="#" class="hover:text-primary transition-colors">Quy chế Hoạt động</a>
            <span>•</span>
            <a href="#" class="hover:text-primary transition-colors">Chính sách Bảo mật</a>
            <span>•</span>
            <a href="#" class="hover:text-primary transition-colors">Hỗ trợ CTSV</a>
        </div>
        <p class="text-[11px] text-slate-400 mt-1">© 2025 EMS-MVC. Hệ thống Quản trị &amp; Tích điểm Sinh viên. Mốc 60%.</p>
    </div>
</div>

@section Scripts {
    <script>
        function togglePasswordVisibility() {
            const passwordInput = document.getElementById('passwordInput');
            const passwordIcon = document.getElementById('passwordIcon');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                passwordIcon.textContent = 'visibility';
            } else {
                passwordInput.type = 'password';
                passwordIcon.textContent = 'visibility_off';
            }
        }

        function fillCredentials(username, password, roleLabel) {
            const usernameInput = document.getElementById('usernameInput');
            const passwordInput = document.getElementById('passwordInput');
            const banner = document.getElementById('roleFilledBanner');
            const roleNameSpan = document.getElementById('filledRoleName');

            usernameInput.value = username;
            passwordInput.value = password;
            roleNameSpan.textContent = roleLabel;
            banner.classList.remove('hidden');

            usernameInput.classList.add('bg-blue-50');
            passwordInput.classList.add('bg-blue-50');
            setTimeout(() => {
                usernameInput.classList.remove('bg-blue-50');
                passwordInput.classList.remove('bg-blue-50');
            }, 300);
        }

        // Tự động điền nếu URL có tham số demoRole (từ trang chủ click sang)
        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            const demoRole = urlParams.get('demoRole');
            if (demoRole === 'student') fillCredentials('sv210145', 'Student@12345', 'Sinh viên (sv210145)');
            else if (demoRole === 'organizer') fillCredentials('organizer', 'Organizer@12345', 'Ban tổ chức (organizer)');
            else if (demoRole === 'manager') fillCredentials('manager', 'Manager@12345', 'Cán bộ quản lý (manager)');
            else if (demoRole === 'admin') fillCredentials('admin', 'Admin@12345', 'Quản trị viên (admin)');
        });
    </script>
}
