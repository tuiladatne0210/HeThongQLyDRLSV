@model List<EMS_MVC.ViewModels.Student.StudentActivityItemViewModel>
@{
    ViewData["Title"] = "Hoạt động đã đăng ký";
    Layout = "_Layout";
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-extrabold text-on-surface tracking-tight">Hoạt động đã đăng ký</h1>
            <p class="text-xs text-status-neutral mt-1">Theo dõi tiến độ tham gia và kết quả điểm danh các hoạt động ngoại khóa của bạn</p>
        </div>
        <a asp-controller="Activities" asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-primary text-white hover:bg-primary-container text-xs font-bold transition-all shadow-sm">
            <span class="material-symbols-outlined text-[18px]">add</span>
            <span>Đăng ký thêm hoạt động</span>
        </a>
    </div>

    <div class="bg-surface rounded-2xl shadow-sm border border-border-subtle overflow-hidden">
        @if (Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 border-b border-border-subtle text-[11px] font-bold uppercase tracking-wider text-status-neutral">
                        <tr>
                            <th class="py-3.5 px-5">Tên hoạt động</th>
                            <th class="py-3.5 px-4">Phân loại</th>
                            <th class="py-3.5 px-4">Thời gian</th>
                            <th class="py-3.5 px-4">Địa điểm</th>
                            <th class="py-3.5 px-4">Điểm</th>
                            <th class="py-3.5 px-4">Trạng thái</th>
                            <th class="py-3.5 px-5 text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-subtle text-slate-700">
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="py-4 px-5">
                                    <div class="font-bold text-on-surface text-sm">@item.Name</div>
                                    @if (!string.IsNullOrEmpty(item.ActivityCode))
                                    {
                                        <div class="text-[11px] text-slate-400 font-mono">#@item.ActivityCode</div>
                                    }
                                </td>
                                <td class="py-4 px-4">
                                    <span class="px-2 py-0.5 rounded-full text-[11px] font-medium bg-slate-100 text-slate-600 border border-slate-200">
                                        @item.ActivityTypeName
                                    </span>
                                </td>
                                <td class="py-4 px-4 whitespace-nowrap">
                                    <div class="font-medium text-slate-800">@item.StartAt.ToString("dd/MM/yyyy HH:mm")</div>
                                    <div class="text-[11px] text-slate-400">đến @item.EndAt.ToString("HH:mm")</div>
                                </td>
                                <td class="py-4 px-4 text-slate-600 max-w-xs truncate">@item.Location</td>
                                <td class="py-4 px-4">
                                    <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-primary">
                                        +@item.Points ĐRL
                                    </span>
                                </td>
                                <td class="py-4 px-4 whitespace-nowrap">
                                    @if (item.RegistrationStatus == "ATTENDED")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">
                                            <span class="material-symbols-outlined text-[14px]">verified</span> Đã tham gia
                                        </span>
                                    }
                                    else if (item.RegistrationStatus == "REGISTERED")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-blue-100 text-primary">
                                            <span class="material-symbols-outlined text-[14px]">how_to_reg</span> Đã đăng ký
                                        </span>
                                    }
                                    else if (item.RegistrationStatus == "CANCELLED")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-500">
                                            <span class="material-symbols-outlined text-[14px]">cancel</span> Đã hủy
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800">
                                            @item.RegistrationStatus
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-5 text-right whitespace-nowrap">
                                    <div class="flex items-center justify-end gap-2">
                                        <a asp-controller="Activities" asp-action="Details" asp-route-id="@item.ActivityId" class="px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-xs font-bold text-slate-700 transition-colors">
                                            Chi tiết
                                        </a>

                                        @if (item.RegistrationStatus == "REGISTERED")
                                        {
                                            <form asp-action="CancelRegistration" method="post" class="m-0 inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="activityId" value="@item.ActivityId" />
                                                <button type="submit" class="px-3 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-bold transition-colors" onclick="return confirm('Bạn có chắc chắn muốn hủy đăng ký hoạt động này?')">
                                                    Hủy
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-16">
                <span class="material-symbols-outlined text-5xl text-slate-300">assignment_late</span>
                <p class="text-sm font-bold text-slate-700 mt-3">Bạn chưa đăng ký hoạt động nào</p>
                <p class="text-xs text-status-neutral mt-1">Hãy khám phá danh mục và đăng ký tham gia các sự kiện trong học kỳ.</p>
                <a asp-controller="Activities" asp-action="Index" class="inline-flex items-center gap-1.5 mt-4 px-4 py-2 rounded-xl bg-primary text-white text-xs font-bold shadow-sm">
                    <span>Khám phá ngay</span>
                    <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </a>
            </div>
        }
    </div>
</div>
