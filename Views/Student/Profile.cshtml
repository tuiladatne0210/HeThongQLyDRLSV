@model EMS_MVC.ViewModels.Student.StudentProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "_Layout";
}

<div class="max-w-3xl mx-auto space-y-6">
    <div class="bg-surface rounded-2xl p-6 sm:p-8 shadow-sm border border-border-subtle space-y-6">
        <!-- Profile Header -->
        <div class="flex items-center gap-4 pb-6 border-b border-border-subtle">
            <div class="w-16 h-16 rounded-2xl bg-primary text-white flex items-center justify-center text-2xl font-black shadow-md shrink-0">
                @(Model.FullName.Substring(0, 1).ToUpper())
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-extrabold text-on-surface">@Model.FullName</h1>
                <div class="flex flex-wrap items-center gap-2 mt-1 text-xs">
                    <span class="px-2.5 py-0.5 rounded-full font-bold bg-primary-light text-primary">Sinh viên chính quy</span>
                    <span class="text-status-neutral font-mono">MSSV: @Model.StudentCode</span>
                </div>
            </div>
        </div>

        <!-- System Notice -->
        <div class="flex items-start gap-3 p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs text-status-neutral">
            <span class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5">verified_user</span>
            <span>Thông tin định danh sinh viên (Mã sinh viên, Lớp, Khoa) được quản lý tập trung và chỉ Quản trị viên (Admin) mới có quyền điều chỉnh.</span>
        </div>

        <form asp-action="UpdateProfile" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <!-- Info Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                <div class="space-y-1.5">
                    <label class="font-bold text-slate-500 uppercase tracking-wider text-[11px]">Mã số sinh viên (MSSV)</label>
                    <input type="text" class="w-full h-10 px-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-700 font-mono font-semibold" value="@Model.StudentCode" readonly />
                </div>

                <div class="space-y-1.5">
                    <label class="font-bold text-slate-500 uppercase tracking-wider text-[11px]">Họ và tên</label>
                    <input type="text" class="w-full h-10 px-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-700 font-semibold" value="@Model.FullName" readonly />
                </div>

                <div class="space-y-1.5">
                    <label class="font-bold text-slate-500 uppercase tracking-wider text-[11px]">Lớp sinh hoạt</label>
                    <input type="text" class="w-full h-10 px-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-700 font-semibold" value="@Model.ClassName" readonly />
                </div>

                <div class="space-y-1.5">
                    <label class="font-bold text-slate-500 uppercase tracking-wider text-[11px]">Khoa / Viện đào tạo</label>
                    <input type="text" class="w-full h-10 px-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-700 font-semibold" value="@Model.DepartmentName" readonly />
                </div>

                <div class="space-y-1.5">
                    <label class="font-bold text-slate-500 uppercase tracking-wider text-[11px]">Tên đăng nhập</label>
                    <input type="text" class="w-full h-10 px-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-700 font-mono" value="@Model.Username" readonly />
                </div>

                <div class="space-y-1.5">
                    <label class="font-bold text-emerald-800 uppercase tracking-wider text-[11px]">Trạng thái tài khoản</label>
                    <input type="text" class="w-full h-10 px-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 font-bold" value="ĐÃ KÍCH HOẠT (ACTIVE)" readonly />
                </div>

                <div class="space-y-1.5">
                    <label class="font-bold text-primary uppercase tracking-wider text-[11px] flex items-center gap-1">
                        <span class="material-symbols-outlined text-[14px]">edit</span> Email cá nhân
                    </label>
                    <input type="email" name="email" class="w-full h-10 px-3 rounded-xl bg-white border-2 border-primary/30 focus:border-primary text-slate-800 font-medium" value="@Model.Email" placeholder="Nhập email cá nhân..." />
                </div>

                <div class="space-y-1.5">
                    <label class="font-bold text-primary uppercase tracking-wider text-[11px] flex items-center gap-1">
                        <span class="material-symbols-outlined text-[14px]">edit</span> Số điện thoại
                    </label>
                    <input type="tel" name="phoneNumber" class="w-full h-10 px-3 rounded-xl bg-white border-2 border-primary/30 focus:border-primary text-slate-800 font-medium" value="@Model.PhoneNumber" placeholder="Nhập số điện thoại..." />
                </div>
            </div>

            <div class="pt-4 border-t border-border-subtle flex flex-wrap items-center justify-between gap-3">
                <button type="submit" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-container text-white text-xs font-bold transition-all shadow-sm">
                    <span class="material-symbols-outlined text-[16px]">save</span>
                    <span>Lưu cập nhật hồ sơ</span>
                </button>

                <div class="flex items-center gap-2">
                    <a asp-controller="Account" asp-action="ChangePassword" class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-colors">
                        <span class="material-symbols-outlined text-[16px]">lock_reset</span>
                        <span>Đổi mật khẩu</span>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>
